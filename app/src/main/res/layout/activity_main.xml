<?xml version="1.1" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a1a"
    android:fitsSystemWindows="true">

    <EditText
        android:id="@+id/tokenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل التوكن هنا"
        android:textColorHint="#888"
        android:textColor="#eee"
        android:inputType="text" />

    <Button
        android:id="@+id/saveTokenBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حفظ التوكن" />

    <Button
        android:id="@+id/hideSelectedBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ إخفاء المحدد"
        android:backgroundTint="#e74c3c"
        android:enabled="false" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="أدخل التوكن أولاً."
        android:padding="8dp"
        android:textColor="#eee" />

    <!-- زر تحديد الكل / إلغاء تحديد الكل -->
    <Button
        android:id="@+id/selectAllBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="☑️ تحديد الكل"
        android:enabled="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/postsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
